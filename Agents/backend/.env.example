# ContOS Agents — never commit real secrets
SUPABASE_URL=https://aoaoloxnzhvyvvdjcbcr.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
OPENROUTER_API_KEY=
LLM_MODEL=moonshotai/kimi-k2.6
PROFILE_SUMMARY_MODEL=google/gemini-2.5-flash
# Loaded from Backend/.env when present (env_loader); declare here for Agents-only deploys
APIFY_API_TOKEN=
APIFY_WEBSITE_CRAWLER_ACTOR_ID=apify/website-content-crawler
WEBSITE_CRAWL_WAIT_SECS=180
WEBSITE_CRAWL_MAX_PAGES=8
WEBSITE_CRAWL_MAX_DEPTH=2
# OpenRouter embedding model (text-embedding-3-small)
EMBEDDING_MODEL=openai/text-embedding-3-small
LLM_ENV=dev
# Must be false in production — tools read live Supabase only
PREFER_MOCK_DATA=false
# Comma-separated user UUIDs allowed to call embedding/admin routes (required when LLM_ENV=prod)
AGENTS_ADMIN_USER_IDS=
CHATBOT_MAX_TOKENS=350
AGENT_MAX_TOKENS=2500
AGENT_MAX_CONTEXT_TOKENS=3500
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000
