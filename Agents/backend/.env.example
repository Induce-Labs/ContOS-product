# ContOS Agents — never commit real secrets
# Web + Celery workers share Supabase; use the pooled connection string in production.
SUPABASE_URL=https://aoaoloxnzhvyvvdjcbcr.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Celery broker (same Redis as Backend scrape queue; local: docker compose up -d from repo root)
REDIS_URL=redis://localhost:6379/0
CELERY_TASK_SOFT_TIME_LIMIT=300
CELERY_TASK_TIME_LIMIT=360
CELERY_WORKER_CONCURRENCY=2
CELERY_WEBSITE_RATE_LIMIT=6/m
CELERY_TASK_MAX_RETRIES=2
CELERY_TASK_RETRY_BACKOFF=15

OPENROUTER_API_KEY=
LLM_MODEL=moonshotai/kimi-k2.6
PROFILE_SUMMARY_MODEL=google/gemini-2.5-flash
# Cheap model for UI/content translation (OpenRouter)
TRANSLATION_MODEL=openai/gpt-4o-mini
TRANSLATION_MAX_RETRIES=3
# Loaded from Backend/.env when present (env_loader); declare here for Agents-only deploys
APIFY_API_TOKEN=
APIFY_WEBSITE_CRAWLER_ACTOR_ID=apify/website-content-crawler
WEBSITE_CRAWL_WAIT_SECS=180
WEBSITE_CRAWL_MAX_PAGES=8
WEBSITE_CRAWL_MAX_DEPTH=2
# OpenRouter embedding model (text-embedding-3-small)
EMBEDDING_MODEL=openai/text-embedding-3-small
LLM_ENV=dev
# Must be false in production — tools read live Supabase only
PREFER_MOCK_DATA=false
# Comma-separated user UUIDs allowed to call embedding/admin routes (required when LLM_ENV=prod)
AGENTS_ADMIN_USER_IDS=
CHATBOT_MAX_TOKENS=350
AGENT_MAX_TOKENS=2500
AGENT_MAX_CONTEXT_TOKENS=3500
# Chat invoke admission (Redis; UTC fixed windows). Daily = calendar day 00:00–23:59 UTC.
AGENTS_RATE_LIMIT_PER_MINUTE=15
AGENTS_RATE_LIMIT_PER_DAY=150
AGENTS_MAX_INFLIGHT_PER_USER=1
# Shared inflight SET safety TTL; SSE refreshes ~every 30s while stream is alive.
AGENTS_INFLIGHT_TTL_SECS=900
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000

# GlitchTip error monitoring (Sentry-compatible SDK). The DSN is the contos-agents
# GlitchTip project DSN, shared by the web process and the website worker.
# Leave empty to disable. Never commit a real DSN. No auth token is required.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
