+  /** Optional vanity handle; empty when /v2/me is forbidden. */
+  private async resolveVanityName(accessToken: string): Promise<string> {
+    try {
+      const response = await fetch('https://api.linkedin.com/v2/me', {
+        headers: {
+          Authorization: `Bearer ${accessToken}`,
+        },
+      });
+      if (!response.ok) {
+        return '';
+      }
+      const body = (await response.json()) as { vanityName?: string };
+      return body.vanityName || '';
+    } catch {
+      return '';
+    }
+  }
