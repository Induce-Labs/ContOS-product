VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Must include https:// in production (http:// causes Railway 301 → POST becomes GET → 405)
VITE_API_BASE_URL=http://localhost:8000
# ContOS Agents API (chat) — separate from scrape Backend
VITE_AGENT_API_BASE_URL=http://localhost:8001
# GlitchTip browser DSN for contos-frontend (Sentry-compatible SDK).
# Safe to expose in the built bundle; still do not commit a real DSN.
# Leave empty to disable. No auth token is required.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development
