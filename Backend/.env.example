# Web + Celery workers share Supabase; use the pooled connection string in production.
SUPABASE_URL=https://aoaoloxnzhvyvvdjcbcr.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Celery broker (local: docker compose up -d from repo root)
REDIS_URL=redis://localhost:6379/0
CELERY_TASK_SOFT_TIME_LIMIT=840
CELERY_TASK_TIME_LIMIT=900
CELERY_WORKER_CONCURRENCY=2
CELERY_SCRAPE_RATE_LIMIT=10/m
CELERY_TASK_MAX_RETRIES=2
CELERY_TASK_RETRY_BACKOFF=15

APIFY_API_TOKEN=
APIFY_INSTAGRAM_ACTOR_ID=apify/instagram-post-scraper
APIFY_TRANSCRIBER_ACTOR_ID=apple_yang/instagram-transcripts-scraper
APIFY_LINKEDIN_ACTOR_ID=datadoping/linkedin-profile-posts-scraper
APIFY_TWITTER_ACTOR_ID=xquik/x-tweet-scraper
# Also used by Agents profiling summarize (website_url → Website Content Crawler)
APIFY_WEBSITE_CRAWLER_ACTOR_ID=apify/website-content-crawler
WEBSITE_CRAWL_WAIT_SECS=180
WEBSITE_CRAWL_MAX_PAGES=8
WEBSITE_CRAWL_MAX_DEPTH=2
# Actor min is 10; free Apify tier caps ~4 profiles / 100 posts per profile
LINKEDIN_MAX_POSTS=50
TWITTER_MAX_ITEMS=50
APIFY_WAIT_SECS=300
# Optional: Instagram session cookie for more reliable reel transcription (see phase-6 docs)
APIFY_INSTAGRAM_SESSION_ID=
TRANSCRIBE_BATCH_SIZE=5
TRANSCRIBE_RETRY_DELAY_SECS=1.5
SCRAPE_LOOKBACK_DAYS=7
PIPELINE_VERBOSE=false
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
# Also used by Agents content/UI translation when TRANSLATION_MODEL is unset there
# TRANSLATION_MODEL=openai/gpt-4o-mini
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
LLM_PROVIDER=auto
LLM_MAX_RETRIES=2
LLM_TIMEOUT_SECS=120
LLM_MAX_TOKENS=4096
LLM_MAX_CONTENT_ITEMS=10
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# Postiz LinkedIn bridge (server-side only — never expose to Vite)
POSTIZ_URL=https://postiz.contos.now
# Shared secret for ContOS → Postiz Approach B provisioning (Bearer on internal routes)
CONTOS_PROVISION_SECRET=
# Optional / legacy ContOS Postiz OAuth App fields (Postiz-side CONTOS_OAUTH_CLIENT_ID)
POSTIZ_CLIENT_ID=pca_WSXwf9ZdqpFrK1Vf3YOtrk1CfA0tybAm
POSTIZ_CLIENT_SECRET=
POSTIZ_REDIRECT_URI=http://localhost:5173/auth/postiz/callback
# Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
POSTIZ_TOKEN_ENCRYPTION_KEY=

# GlitchTip error monitoring (Sentry-compatible SDK). The DSN is the contos-backend
# GlitchTip project DSN, shared by the web process and the scrape worker.
# Leave empty to disable. Never commit a real DSN. No auth token is required.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
